manifest {
    name            = 'simple-nextflow-salmon'
    author          = 'Thokas99'
    description     = 'Paired-end RNA-seq quality control and Salmon quantification with tximport summaries.'
    version         = '0.3.1'
    mainScript      = 'main.nf'
    homePage        = 'https://github.com/Thokas99/simple-nextflow-salmon'
    nextflowVersion = '>=24.10.0'
}

params {
    samplesheet = null
    outdir = 'results'
    reference_dir = 'reference/GRCh38_GENCODE/raw'
    reference_cache_dir = null
    gencode_release = 50
    genome_patch = 14
    salmon_k = 31
    salmon_version = '2.3.4'
    lib_type = 'A'
    validate_only = false
    refresh_reference = false

    fastqc_cpus = 2
    reference_cpus = 2
    index_cpus = 8
    salmon_cpus = 8
    tximport_cpus = 2
    summary_cpus = 1
    multiqc_cpus = 1

    fastqc_memory = '2 GB'
    reference_memory = '8 GB'
    index_memory = '32 GB'
    salmon_memory = '16 GB'
    tximport_memory = '16 GB'
    summary_memory = '4 GB'
    multiqc_memory = '4 GB'
}

process.errorStrategy = 'terminate'

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.tsv"
    overwrite = true
    sep = '\t'
    fields = 'task_id,hash,process,tag,status,exit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

profiles {
    conda {
        conda.enabled = true
        conda.useMicromamba = true
        process.conda = "${projectDir}/envs/salmon-rnaseq.yml"
    }
    docker {
        docker.enabled = true
        process.container = 'ghcr.io/thokas99/simple-nextflow-salmon:0.3.1'
    }
    apptainer {
        apptainer.enabled = true
        process.container = 'docker://ghcr.io/thokas99/simple-nextflow-salmon:0.3.1'
    }
    singularity {
        singularity.enabled = true
        process.container = 'docker://ghcr.io/thokas99/simple-nextflow-salmon:0.3.1'
    }
    ci {
        process.cpus = 1
        process.memory = '2 GB'
        params {
            fastqc_cpus = 1
            reference_cpus = 1
            index_cpus = 1
            salmon_cpus = 1
            tximport_cpus = 1
            summary_cpus = 1
            multiqc_cpus = 1
            fastqc_memory = '1 GB'
            reference_memory = '2 GB'
            index_memory = '2 GB'
            salmon_memory = '2 GB'
            tximport_memory = '2 GB'
            summary_memory = '1 GB'
            multiqc_memory = '1 GB'
        }
    }
}
