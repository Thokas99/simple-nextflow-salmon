{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Thokas99/simple-nextflow-salmon/blob/main/nextflow_schema.json",
  "title": "simple-nextflow-salmon parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["samplesheet"],
  "properties": {
    "samplesheet": {"type": "string", "description": "CSV with exactly sample, fastq_1, fastq_2"},
    "outdir": {"type": "string", "default": "results"},
    "reference_dir": {"type": "string", "default": "reference/GRCh38_GENCODE/raw"},
    "reference_cache_dir": {"type": ["string", "null"], "default": null},
    "gencode_release": {"type": "integer", "minimum": 1, "default": 50},
    "genome_patch": {"type": "integer", "minimum": 1, "default": 14},
    "salmon_k": {"type": "integer", "minimum": 1, "maximum": 31, "default": 31},
    "salmon_version": {"const": "2.3.4"},
    "lib_type": {"type": "string", "pattern": "^(A|[IU][SFUO][RFUO])$", "default": "A"},
    "validate_only": {"type": "boolean", "default": false},
    "refresh_reference": {"type": "boolean", "default": false},
    "fastqc_cpus": {"type": "integer", "minimum": 1},
    "reference_cpus": {"type": "integer", "minimum": 1},
    "index_cpus": {"type": "integer", "minimum": 1},
    "salmon_cpus": {"type": "integer", "minimum": 1},
    "tximport_cpus": {"type": "integer", "minimum": 1},
    "summary_cpus": {"type": "integer", "minimum": 1},
    "multiqc_cpus": {"type": "integer", "minimum": 1},
    "fastqc_memory": {"type": "string"},
    "reference_memory": {"type": "string"},
    "index_memory": {"type": "string"},
    "salmon_memory": {"type": "string"},
    "tximport_memory": {"type": "string"},
    "summary_memory": {"type": "string"},
    "multiqc_memory": {"type": "string"}
  }
}
